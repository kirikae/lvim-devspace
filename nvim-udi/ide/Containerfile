# nvim-udi-ide — Tree-sitter and LSP on top of nvim-udi-base.
#
# Layer 2 of 2. Everything is vendored at build time: parsers are compiled
# here, language servers are downloaded here, and nothing is fetched on first
# run. A workspace on a restricted network gets a working editor immediately.
#
# BASE_IMAGE is the published base layer, so this builds against exactly the
# image that was tested and released rather than rebuilding it. Point it at a
# local tag to iterate on both layers at once.

ARG BASE_IMAGE=ghcr.io/kirikae/terminal-devspaces/nvim-udi-base:latest
FROM ${BASE_IMAGE}

USER 0

# Build-time toolchain for the parsers, plus clangd.
#
# clangd comes from dnf rather than an upstream LLVM release because LLVM
# publishes no aarch64 Linux build — one install path for every architecture is
# worth more here than a newer clangd. tree-sitter-cli is needed for the
# grammars that ship a grammar.js instead of pre-generated C.
RUN dnf -y --setopt=install_weak_deps=False install \
      tree-sitter-cli \
      clang-tools-extra \
      gcc-c++ \
      git \
 && dnf clean all \
 && rm -rf /var/cache/dnf

# --- Tree-sitter -------------------------------------------------------------
ARG NVIM_TREESITTER_REF=f603a2f4da48728f80257fb5fbb90145fd1dc173
COPY parsers.txt vendor-treesitter.sh /tmp/vendor/
RUN chmod +x /tmp/vendor/vendor-treesitter.sh \
 && NVIM_TREESITTER_REF="${NVIM_TREESITTER_REF}" \
    /tmp/vendor/vendor-treesitter.sh /tmp/vendor/parsers.txt

# --- Language servers --------------------------------------------------------
ARG NVIM_LSPCONFIG_REF=v2.11.0
ARG NODE_VERSION=22.23.2
ARG LUA_LS_VERSION=3.19.1
ARG RUST_ANALYZER_VERSION=2026-09-21
ARG MARKSMAN_VERSION=2026-02-08
ARG GOPLS_VERSION=v0.23.0
# typescript is pinned to 5.x on purpose: typescript-language-server drives
# tsserver, and TypeScript 7 replaced it with a different native binary.
ARG NPM_PACKAGES="bash-language-server@5.8.1 yaml-language-server@1.24.0 vscode-langservers-extracted@4.10.0 typescript-language-server@6.0.0 typescript@5.9.3 pyright@1.1.414"

# nvim-lspconfig is vendored for its lsp/<name>.lua definitions only; Neovim
# reads those straight off 'runtimepath', so none of its Lua modules are loaded
# at runtime.
RUN set -eux; \
    git clone --quiet --filter=blob:none --branch "${NVIM_LSPCONFIG_REF}" \
        https://github.com/neovim/nvim-lspconfig /usr/share/nvim/vendor/nvim-lspconfig; \
    echo "${NVIM_LSPCONFIG_REF}" > /usr/share/nvim/vendor/nvim-lspconfig/.vendored-ref; \
    rm -rf /usr/share/nvim/vendor/nvim-lspconfig/.git \
           /usr/share/nvim/vendor/nvim-lspconfig/test; \
    chmod -R a+rX /usr/share/nvim/vendor/nvim-lspconfig

COPY vendor-lsp.sh /tmp/vendor/
RUN chmod +x /tmp/vendor/vendor-lsp.sh && /tmp/vendor/vendor-lsp.sh && rm -rf /tmp/vendor

# --- Config drop-ins ---------------------------------------------------------
# These extend the base config rather than replacing it: init.lua sources
# everything in devspace.d after its own modules. A user config in
# ~/.config/nvim still overrides the lot.
COPY config/devspace.d/ /etc/xdg/nvim/devspace.d/

USER 10001

# Prove the layer works before publishing it. verify.lua starts every language
# server for real and parses a buffer per language, because "the binary exists"
# is not the same claim as "the editor works" — see the comment at the top of
# that file. Note this runs via -c luafile, not -l: script mode skips the user
# config, so none of /etc/xdg/nvim would be loaded and the test would check
# nothing.
COPY verify.lua /tmp/verify.lua
RUN set -eux; \
    nvim --headless -c 'luafile /tmp/verify.lua' -c 'quitall'; \
    rm -f /tmp/verify.lua; \
    rm -rf /home/user/.local/state/nvim/shada \
           /home/user/.local/state/nvim/*.log \
           /home/user/.local/state/lua-language-server
